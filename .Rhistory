name    = "Wind speed (m s⁻¹)"
)
ggplot(df, aes(lon, lat, fill = speed)) +
geom_raster() +
#borders("world", colour = "black", fill = NA) +
coord_fixed(expand = FALSE) +
scale_fill_viridis_c(
name = "Wind speed (m s⁻¹)",
limits = c(0, 30)
) +
labs(
title = "ERA5 10 m Wind Speed",
x = "Longitude",
y = "Latitude"
) +
theme_minimal() +
scale_fill_gradientn(
colours = "Spectral")
ggplot(df, aes(lon, lat, fill = speed)) +
geom_raster() +
#borders("world", colour = "black", fill = NA) +
coord_fixed(expand = FALSE) +
scale_fill_viridis_c(
