library(devtools)
library(tidyverse)
devtools::load_all()
conn <- Connector$new()
catalog <- conn$get_catalog("oceanum 1km")
catalog
query_input <- Query$new(
datasource = "oceanum_wave_nz1km_nz17_era5_spec",
variables = c("dpt", "lon", "lat","wspd")
)
data <- conn$query(query_input, row_limit = 1000000000)
dpt <- data$data_vars$dpt$data
lon <- data$coords$lon$data
lat <- data$coords$lat$data
time <- data$coords$time$data
wspd <- data$data_vars$wspd$data
location_df <- tibble(lon = lon, lat = lat)
dim(wspd)
location_df <- tibble(
site = seq_along(lon),
lon  = lon,
lat  = lat
)
site_id <- 1  # pick any 1–45
df_ts <- tibble(
time = as.POSIXct(time),
wspd = wspd[, site_id]
)
ggplot(df_ts, aes(time, wspd)) +
geom_line(alpha = 0.7) +
labs(
title = paste("Wind speed time series – site", site_id),
x = "Time",
y = "Wind speed (m/s)"
) +
theme_minimal()
df_box <- as_tibble(wspd) |>
mutate(time = as.POSIXct(time)) |>
pivot_longer(
cols = -time,
names_to = "site",
values_to = "wspd"
)
ggplot(df_box, aes(site, wspd)) +
geom_boxplot(outlier.alpha = 0.1) +
labs(
title = "Wind speed distribution by location",
x = "Site",
y = "Wind speed (m/s)"
) +
theme_minimal()
df_mean <- location_df |>
mutate(mean_wspd = colMeans(wspd, na.rm = TRUE))
ggplot(df_mean, aes(lon, lat, color = mean_wspd)) +
geom_point(size = 3) +
coord_equal() +
scale_color_viridis_c() +
labs(
title = "Mean wind speed",
color = "m/s"
) +
theme_minimal()
df_mean <- location_df |>
mutate(mean_wspd = colMeans(wspd, na.rm = TRUE))
ggplot(df_mean, aes(lon, lat, color = mean_wspd)) +
geom_point(size = 3) +
coord_equal() +
scale_color_viridis_c() +
labs(
title = "Mean wind speed",
color = "m/s"
) +
theme_minimal()
